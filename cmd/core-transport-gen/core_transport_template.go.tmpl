func metadataFromContext(ctx context.Context) coreapp.TransportMetadata {
	values, _ := metadata.FromIncomingContext(ctx)
	authorization := ""
	if items := values.Get("authorization"); len(items) != 0 {
		authorization = items[0]
	}
	tenant := ""
	if items := values.Get("x-tenant-id"); len(items) != 0 {
		tenant = items[0]
	}
	traceparent := ""
	if items := values.Get("traceparent"); len(items) != 0 {
		traceparent = items[0]
	}
	requestID := ""
	if items := values.Get("x-request-id"); len(items) != 0 {
		requestID = items[0]
	}
	return coreapp.TransportMetadata{Authorization: authorization, TenantID: tenant, Traceparent: traceparent, RequestID: requestID}
}

func formatTenantID(value int64) string {
	if value == 0 {
		return ""
	}
	return strconv.FormatInt(value, 10)
}

func projectCoreRPCError(err error) error {
	projected := coreapp.ProjectTransportError(err)
	if projected == nil {
		return nil
	}
	code := codes.Internal
	switch projected.Code {
	case "invalid_argument":
		code = codes.InvalidArgument
	case "unauthenticated":
		code = codes.Unauthenticated
	case "permission_denied":
		code = codes.PermissionDenied
	case "not_found":
		code = codes.NotFound
	case "aborted":
		code = codes.Aborted
	case "failed_precondition":
		code = codes.FailedPrecondition
	case "unavailable":
		code = codes.Unavailable
	case "canceled":
		code = codes.Canceled
	}
	return grpcstatus.Error(code, projected.Message)
}

