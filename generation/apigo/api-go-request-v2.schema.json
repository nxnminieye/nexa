{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/generation/apigo/api-go-request-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "coreServiceId", "modulePath", "httpAPIIR", "apiEntry", "staticInputs", "outputScopes"],
  "properties": {
    "apiVersion": {"const": "nexa.dev/api-go-request/v2"},
    "kind": {"const": "APIGoRequest"},
    "coreServiceId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "modulePath": {"type": "string", "minLength": 1, "maxLength": 1024},
    "httpAPIIR": {"$ref": "https://nexa.dev/schemas/generation/httpapi/api-ir-v1.schema.json"},
    "apiEntry": {"type": "string", "pattern": "^.+\\.api$"},
    "staticInputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "path", "digest"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"}, "path": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "outputScopes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "mode"], "properties": {"path": {"type": "string", "minLength": 1}, "mode": {"enum": ["replace-tree", "file-set"]}}}}
  }
}
