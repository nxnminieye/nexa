{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/generation/apigo/api-go-request-v2.schema.json",
  "$comment": "The Go owner enforces Unicode NFC case-fold uniqueness, static-input and scope topology, API-entry membership, canonical ordering, and complete Go module-path syntax.",
  "x-nexa-unicode-casefold-uniqueness": {"normalization": "NFC", "caseFold": "Unicode default case folding", "enforcedBy": "generation/apigo Go parser"},
  "x-nexa-path-topology": {"rule": "static input paths and output scopes must be disjoint both within and across sets under exact, ancestor, descendant, NFC, and component-wise Unicode case-fold comparison", "enforcedBy": "generation/apigo Go parser"},
  "x-nexa-canonical-order": {"staticInputs": "id then path", "outputScopes": "path then mode", "enforcedBy": "generation/apigo Go parser"},
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "coreServiceId", "modulePath", "httpAPIIR", "apiEntry", "staticInputs", "outputScopes"],
  "properties": {
    "apiVersion": {"const": "nexa.dev/api-go-request/v2"},
    "kind": {"const": "APIGoRequest"},
    "coreServiceId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "modulePath": {"type": "string", "minLength": 1, "maxLength": 1024},
    "httpAPIIR": {"$ref": "https://nexa.dev/schemas/generation/httpapi/api-ir-v1.schema.json"},
    "apiEntry": {"allOf": [{"$ref": "#/$defs/repositoryPath"}, {"pattern": "\\.api$"}]},
    "staticInputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/staticInput"}},
    "outputScopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/scope"}}
  },
  "$defs": {
    "repositoryPath": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+(?:/[^/\\\\]+)*$", "not": {"anyOf": [{"pattern": "\u0000"}, {"pattern": "(^|/)(\\.|\\.\\.|\\.[gG][iI][tT])(/|$)"}]}},
    "staticInput": {"type": "object", "additionalProperties": false, "required": ["id", "path", "digest"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"}, "path": {"$ref": "#/$defs/repositoryPath"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["path", "mode"], "properties": {"path": {"$ref": "#/$defs/repositoryPath"}, "mode": {"enum": ["replace-tree", "file-set"]}}}
  }
}
