{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/generation/apigo/api-go-result-v2.schema.json",
  "$comment": "The Go owner enforces Unicode NFC case-fold uniqueness, cross-scope topology, and canonical ordering.",
  "x-nexa-unicode-casefold-uniqueness": {"normalization": "NFC", "caseFold": "Unicode default case folding", "enforcedBy": "generation/apigo Go parser"},
  "x-nexa-path-topology": {"rule": "output scopes must not duplicate or overlap under component-wise Unicode case-fold comparison", "enforcedBy": "generation/apigo Go parser"},
  "x-nexa-canonical-order": {"outputScopes": "path then mode", "enforcedBy": "generation/apigo Go parser"},
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "status", "coreServiceId", "inputDigest", "outputScopes"],
  "properties": {
    "apiVersion": {"const": "nexa.dev/api-go-result/v2"},
    "kind": {"const": "APIGoResult"},
    "status": {"const": "generated"},
    "coreServiceId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "inputDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "outputScopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/scope"}}
  },
  "$defs": {
    "repositoryPath": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+(?:/[^/\\\\]+)*$", "not": {"anyOf": [{"pattern": "\u0000"}, {"pattern": "(^|/)(\\.|\\.\\.|\\.[gG][iI][tT])(/|$)"}]}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["path", "mode"], "properties": {"path": {"$ref": "#/$defs/repositoryPath"}, "mode": {"enum": ["replace-tree", "file-set"]}}}
  }
}
