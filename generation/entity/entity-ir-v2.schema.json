{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/generation/entity/entity-ir-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "sourceDigest", "sources", "entities"],
  "properties": {
    "apiVersion": {"const": "nexa.dev/entity-ir/v2"},
    "kind": {"const": "EntityIR"},
    "sourceDigest": {"$ref": "#/$defs/digest"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceRef": {"type": "string", "pattern": "^repo:.+"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {"ref": {"$ref": "#/$defs/sourceRef"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "zhCN", "enUS"],
      "properties": {"key": {"type": "string", "minLength": 1}, "zhCN": {"type": "string", "minLength": 1}, "enUS": {"type": "string", "minLength": 1}}
    },
    "schemaMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "payload"],
      "properties": {
        "apiVersion": {"const": "nexa.dev/ent-schema-meta/v1"},
        "kind": {"const": "EntSchemaMeta"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "description", "identity", "scope"],
          "properties": {
            "label": {"$ref": "#/$defs/localizedText"},
            "description": {"$ref": "#/$defs/localizedText"},
            "identity": {"enum": ["ent-id"]},
            "scope": {"enum": ["global", "tenant"]}
          }
        }
      }
    },
    "physicalDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": {"type": "string", "minLength": 1}
      }
    },
    "logicalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "display"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "display": {"type": "string", "minLength": 1}
      }
    },
    "fieldMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "payload"],
      "properties": {
        "apiVersion": {"const": "nexa.dev/ent-field-meta/v1"},
        "kind": {"const": "EntFieldMeta"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "description", "uiHint", "visibility"],
          "properties": {
            "label": {"$ref": "#/$defs/localizedText"},
            "description": {"$ref": "#/$defs/localizedText"},
            "uiHint": {"enum": ["text", "textarea", "number", "switch", "select", "multi-select", "datetime", "json", "readonly", "sensitive", "member", "reference", "attachment", "tags", "component", "i18n", "iconify", "permission", "route", "scope", "http-method", "http-path", "module", "locale", "timezone"]},
            "physicalDisplay": {"$ref": "#/$defs/physicalDisplay"},
            "logicalReference": {"$ref": "#/$defs/logicalReference"},
            "visibility": {"enum": ["public", "internal", "sensitive"]},
            "crud": {
              "type": "object",
              "additionalProperties": false,
              "required": ["read", "mutation"],
              "properties": {"read": {"enum": ["include", "exclude"]}, "mutation": {"enum": ["none", "create", "update", "create-update"]}}
            }
          },
          "not": {"required": ["physicalDisplay", "logicalReference"]}
        }
      }
    },
    "crud": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "payload"],
      "properties": {
        "apiVersion": {"const": "nexa.dev/ent-crud/v1"},
        "kind": {"const": "EntCRUD"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operations"],
          "properties": {"operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["list", "get", "create", "update", "delete"]}}}
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "type", "sourceRef"],
      "properties": {
        "kind": {"enum": ["implicit", "field"]},
        "name": {"type": "string", "minLength": 1},
        "type": {"$ref": "#/$defs/scalar"},
        "sourceRef": {"$ref": "#/$defs/sourceRef"}
      }
    },
    "scalar": {"enum": ["bool", "int64", "uint64", "float", "double", "string", "bytes", "timestamp", "uuid", "json", "enum"]},
    "enumValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sourceRef", "type", "enumValues", "optional", "nillable", "immutable", "hasDefault", "sensitive", "isIdentity", "isTenantField", "fieldMeta"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "sourceRef": {"$ref": "#/$defs/sourceRef"},
        "type": {"$ref": "#/$defs/scalar"},
        "enumValues": {"type": "array", "items": {"$ref": "#/$defs/enumValue"}},
        "optional": {"type": "boolean"},
        "nillable": {"type": "boolean"},
        "immutable": {"type": "boolean"},
        "hasDefault": {"type": "boolean"},
        "sensitive": {"type": "boolean"},
        "isIdentity": {"type": "boolean"},
        "isTenantField": {"type": "boolean"},
        "fieldMeta": {"$ref": "#/$defs/fieldMeta"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sourceRef", "targetEntityId", "direction", "optional", "unique"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "sourceRef": {"$ref": "#/$defs/sourceRef"},
        "targetEntityId": {"type": "string", "pattern": "^schema:.+"},
        "direction": {"enum": ["to", "from"]},
        "inverseName": {"type": "string", "minLength": 1},
        "boundFieldId": {"type": "string", "pattern": "^schema:.+/field:.+"},
        "optional": {"type": "boolean"},
        "unique": {"type": "boolean"}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sourceRef", "schemaMeta", "identity", "fields", "edges"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "sourceRef": {"$ref": "#/$defs/sourceRef"},
        "schemaMeta": {"$ref": "#/$defs/schemaMeta"},
        "crud": {"$ref": "#/$defs/crud"},
        "identity": {"$ref": "#/$defs/identity"},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
      }
    }
  }
}
