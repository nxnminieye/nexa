{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/generation/entity/entity-ir-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "sourceDigest", "sources", "entities"],
  "properties": {
    "apiVersion": {"const": "nexa.dev/entity-ir/v3"},
    "kind": {"const": "EntityIR"},
    "sourceDigest": {"$ref": "#/$defs/digest"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceRef": {"type": "string", "pattern": "^repo:.+"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {"ref": {"$ref": "#/$defs/sourceRef"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "zhCN", "enUS"],
      "properties": {"key": {"type": "string", "minLength": 1}, "zhCN": {"type": "string", "minLength": 1}, "enUS": {"type": "string", "minLength": 1}}
    },
    "schemaFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description", "scope"],
      "properties": {
        "label": {"$ref": "#/$defs/localizedText"},
        "description": {"$ref": "#/$defs/localizedText"},
        "scope": {"enum": ["global", "tenant"]}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "display"],
      "properties": {
        "target": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
        "display": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
      }
    },
    "fieldFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description", "control", "visibility"],
      "properties": {
        "label": {"$ref": "#/$defs/localizedText"},
        "description": {"$ref": "#/$defs/localizedText"},
        "control": {"enum": ["text", "textarea", "number", "switch", "select", "multi-select", "datetime", "readonly", "sensitive", "member", "reference", "attachment", "tags", "component", "i18n", "iconify", "permission", "route", "scope", "http-method", "http-path", "module", "locale", "timezone"]},
        "reference": {"$ref": "#/$defs/reference"},
        "visibility": {"enum": ["public", "internal", "sensitive"]},
        "crud": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "mutation"],
          "properties": {"read": {"enum": ["include", "exclude"]}, "mutation": {"enum": ["none", "create", "update", "create-update"]}}
        }
      }
    },
    "crud": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations"],
      "properties": {"operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["list", "get", "create", "update", "delete"]}}}
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "type", "sourceRef"],
      "properties": {
        "kind": {"enum": ["implicit", "field"]},
        "name": {"type": "string", "minLength": 1},
        "type": {"$ref": "#/$defs/scalar"},
        "sourceRef": {"$ref": "#/$defs/sourceRef"}
      }
    },
    "scalar": {"enum": ["bool", "int64", "uint64", "float", "double", "string", "bytes", "timestamp", "uuid", "json", "enum"]},
    "enumValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sourceRef", "type", "enumValues", "optional", "nillable", "immutable", "hasDefault", "sensitive", "isIdentity", "isTenantField", "fieldFacts"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "sourceRef": {"$ref": "#/$defs/sourceRef"},
        "type": {"$ref": "#/$defs/scalar"},
        "enumValues": {"type": "array", "items": {"$ref": "#/$defs/enumValue"}},
        "optional": {"type": "boolean"},
        "nillable": {"type": "boolean"},
        "immutable": {"type": "boolean"},
        "hasDefault": {"type": "boolean"},
        "sensitive": {"type": "boolean"},
        "isIdentity": {"type": "boolean"},
        "isTenantField": {"type": "boolean"},
        "fieldFacts": {"$ref": "#/$defs/fieldFacts"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sourceRef", "targetEntityId", "direction", "optional", "unique"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "sourceRef": {"$ref": "#/$defs/sourceRef"},
        "targetEntityId": {"type": "string", "minLength": 1},
        "direction": {"enum": ["to", "from"]},
        "inverseName": {"type": "string", "minLength": 1},
        "boundFieldId": {"type": "string", "minLength": 1},
        "optional": {"type": "boolean"},
        "unique": {"type": "boolean"}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sourceRef", "schemaFacts", "identity", "fields", "edges"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "sourceRef": {"$ref": "#/$defs/sourceRef"},
        "schemaFacts": {"$ref": "#/$defs/schemaFacts"},
        "crud": {"$ref": "#/$defs/crud"},
        "identity": {"$ref": "#/$defs/identity"},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
      }
    }
  }
}
