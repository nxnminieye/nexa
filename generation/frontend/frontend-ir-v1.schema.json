{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/generation/frontend/frontend-ir-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "apiDigest",
    "sourceDigest",
    "sources",
    "api",
    "locales",
    "pages"
  ],
  "properties": {
    "apiVersion": {
      "const": "nexa.dev/frontend-ir/v1"
    },
    "kind": {
      "const": "FrontendIR"
    },
    "apiDigest": {
      "$ref": "#/$defs/digest"
    },
    "sourceDigest": {
      "$ref": "#/$defs/digest"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "api": {
      "$ref": "https://nexa.dev/schemas/generation/httpapi/api-ir-v1.schema.json"
    },
    "locales": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/locale"
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "valueType": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "scalar" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "ref" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "object" },
            "name": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "element"],
          "properties": {
            "kind": { "const": "array" },
            "element": { "$ref": "#/$defs/nonOptionalValueType" }
          }
        }
      ]
    },
    "scalarValueType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "scalar" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "nonOptionalValueType": {
      "oneOf": [
        { "$ref": "#/$defs/scalarValueType" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "ref" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "object" },
            "name": { "type": "string" }
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "path",
        "valueType"
      ],
      "properties": {
        "context": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "valueType": {
          "$ref": "#/$defs/valueType"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "itemsPath": {
          "$ref": "#/$defs/path"
        },
        "itemPath": {
          "$ref": "#/$defs/path"
        },
        "totalPath": {
          "$ref": "#/$defs/path"
        },
        "rowKeyPath": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "limitPath",
        "offsetPath",
        "totalPath",
        "pageSize"
      ],
      "properties": {
        "mode": {
          "const": "offset"
        },
        "limitPath": {
          "$ref": "#/$defs/path"
        },
        "offsetPath": {
          "$ref": "#/$defs/path"
        },
        "totalPath": {
          "$ref": "#/$defs/path"
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "operationId",
        "permission",
        "requestType",
        "responseType",
        "contextBindings"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "list",
            "get",
            "action",
            "options"
          ]
        },
        "operationId": {
          "type": "string"
        },
        "permission": {
          "type": "string"
        },
        "requestType": {
          "type": "string"
        },
        "responseType": {
          "type": "string"
        },
        "contextBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/context"
          }
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "pagination": {
          "$ref": "#/$defs/pagination"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "direction",
        "path",
        "valueType",
        "required"
      ],
      "properties": {
        "operation": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "request",
            "response"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "valueType": {
          "$ref": "#/$defs/valueType"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "valuePath",
        "labelPath"
      ],
      "properties": {
        "operation": {
          "type": "string"
        },
        "valuePath": {
          "$ref": "#/$defs/path"
        },
        "labelPath": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "labelKey"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labelKey",
        "path",
        "valueType",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "valueType": {
          "$ref": "#/$defs/valueType"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labelKey",
        "surfaces",
        "bindings"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "surfaces": {
          "type": "array",
          "items": {
            "enum": [
              "search",
              "list",
              "detail"
            ]
          }
        },
        "control": {
          "enum": [
            "text",
            "textarea",
            "password",
            "number",
            "toggle",
            "select",
            "multi-select"
          ]
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          }
        }
      }
    },
      "action": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "labelKey",
          "operation",
          "effect",
          "fields",
          "placement"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "labelKey": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "effect": {
            "enum": [
              "create",
              "update",
              "delete"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "placement": {
            "enum": [
              "toolbar",
              "row"
            ]
          },
          "confirmKey": {
            "type": "string"
          }
        }
      },
      "route": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "name"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "menu": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "titleKey",
          "order"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "parentId": {
            "type": "string"
          },
          "titleKey": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          }
        }
      },
      "locale": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locale",
          "messages",
          "sourceRef"
        ],
        "properties": {
          "locale": {
            "type": "string"
          },
          "messages": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "sourceRef": {
            "type": "string"
          }
        }
      },
      "page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "titleKey",
          "mode",
          "accessOperation",
          "accessPermission",
          "route",
          "operations",
          "fields",
          "actions",
          "extensionPoints",
          "specSourceRef"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "titleKey": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "collection",
              "singleton"
            ]
          },
          "accessOperation": {
            "type": "string"
          },
          "accessPermission": {
            "type": "string"
          },
          "route": {
            "$ref": "#/$defs/route"
          },
          "menu": {
            "$ref": "#/$defs/menu"
          },
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/operation"
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/field"
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/action"
            }
          },
          "extensionPoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "specSourceRef": {
            "type": "string"
          }
        }
      }
    }
}
