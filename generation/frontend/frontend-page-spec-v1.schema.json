{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/generation/frontend/frontend-page-spec-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "id",
    "titleKey",
    "mode",
    "accessOperation",
    "route",
    "operations",
    "fields",
    "actions",
    "extensionPoints"
  ],
  "properties": {
    "apiVersion": {
      "const": "nexa.dev/frontend-page-spec/v1"
    },
    "kind": {
      "const": "FrontendPageSpec"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "titleKey": {
      "$ref": "#/$defs/messageKey"
    },
    "mode": {
      "enum": [
        "collection",
        "singleton"
      ]
    },
    "accessOperation": {
      "$ref": "#/$defs/id"
    },
    "route": {
      "$ref": "#/$defs/route"
    },
    "menu": {
      "$ref": "#/$defs/menu"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "extensionPoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "messageKey": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*(?:[.-][A-Za-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^.]+$"
      }
    },
    "directPath": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^.]+$"
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "name"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:/|/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*)$"
        },
        "name": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "menu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "titleKey",
        "order"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "parentId": {
          "$ref": "#/$defs/id"
        },
        "titleKey": {
          "$ref": "#/$defs/messageKey"
        },
        "icon": {
          "$ref": "#/$defs/text"
        },
        "order": {
          "type": "integer"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "itemsPath": {
          "$ref": "#/$defs/path"
        },
        "itemPath": {
          "$ref": "#/$defs/path"
        },
        "totalPath": {
          "$ref": "#/$defs/path"
        },
        "rowKeyPath": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "limitPath",
        "offsetPath",
        "totalPath",
        "pageSize"
      ],
      "properties": {
        "mode": {
          "const": "offset"
        },
        "limitPath": {
          "$ref": "#/$defs/directPath"
        },
        "offsetPath": {
          "$ref": "#/$defs/directPath"
        },
        "totalPath": {
          "$ref": "#/$defs/path"
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "contextBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "path"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/directPath"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "operationId",
        "contextBindings"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "list",
            "get",
            "action",
            "options"
          ]
        },
        "operationId": {
          "$ref": "#/$defs/text"
        },
        "contextBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextBinding"
          }
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "pagination": {
          "$ref": "#/$defs/pagination"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "direction",
        "path"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/id"
        },
        "direction": {
          "enum": [
            "request",
            "response"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "labelKey"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/text"
        },
        "labelKey": {
          "$ref": "#/$defs/messageKey"
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labelKey",
        "path"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "labelKey": {
          "$ref": "#/$defs/messageKey"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "valuePath",
        "labelPath"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/id"
        },
        "valuePath": {
          "$ref": "#/$defs/path"
        },
        "labelPath": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labelKey",
        "surfaces",
        "bindings"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "labelKey": {
          "$ref": "#/$defs/messageKey"
        },
      "surfaces": {
        "type": "array",
        "items": {
            "enum": [
              "search",
              "list",
              "detail"
            ]
          }
        },
        "control": {
          "enum": [
            "text",
            "password",
            "textarea",
            "number",
            "select",
            "multi-select",
            "toggle"
          ]
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "options",
              "choices"
            ]
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labelKey",
        "operation",
        "effect",
        "fields",
        "placement"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "labelKey": {
          "$ref": "#/$defs/messageKey"
        },
        "operation": {
          "$ref": "#/$defs/id"
        },
        "effect": {
          "enum": [
            "create",
            "update",
            "delete"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "placement": {
          "enum": [
            "toolbar",
            "row"
          ]
        },
        "confirmKey": {
          "$ref": "#/$defs/messageKey"
        }
      }
    }
  }
}
