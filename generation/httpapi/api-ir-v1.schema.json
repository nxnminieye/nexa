{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/generation/httpapi/api-ir-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "sourceDigest", "sources", "types", "operations"],
  "properties": {
    "apiVersion": {"const": "nexa.dev/http-api-ir/v1"},
    "kind": {"const": "HTTPAPIIR"},
    "sourceDigest": {"$ref": "#/$defs/digest"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "types": {"type": "array", "items": {"$ref": "#/$defs/type"}},
    "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceRef": {"type": "string", "pattern": "^repo:.+"},
    "source": {"type": "object", "additionalProperties": false, "required": ["ref", "digest"], "properties": {"ref": {"$ref": "#/$defs/sourceRef"}, "digest": {"$ref": "#/$defs/digest"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["kind", "sources"], "properties": {"kind": {"enum": ["native", "generated"]}, "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}}}},
    "value": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["object", "scalar", "ref", "array", "optional", "map"]}, "name": {"type": "string", "minLength": 1}, "element": {"$ref": "#/$defs/value"}, "key": {"$ref": "#/$defs/value"}, "value": {"$ref": "#/$defs/value"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["in", "name"], "properties": {"in": {"enum": ["path", "query", "header", "body"]}, "name": {"type": "string", "minLength": 1}}},
    "origin": {"type": "object", "additionalProperties": false, "required": ["ref", "digest"], "properties": {"ref": {"$ref": "#/$defs/sourceRef"}, "digest": {"$ref": "#/$defs/digest"}}},
    "field": {"type": "object", "additionalProperties": false, "required": ["path", "required", "valueType", "provenance"], "properties": {"path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "required": {"type": "boolean"}, "valueType": {"$ref": "#/$defs/value"}, "binding": {"$ref": "#/$defs/binding"}, "origin": {"$ref": "#/$defs/origin"}, "provenance": {"$ref": "#/$defs/provenance"}}},
    "type": {"type": "object", "additionalProperties": false, "required": ["name", "shape", "fields", "provenance"], "properties": {"name": {"type": "string", "minLength": 1}, "shape": {"$ref": "#/$defs/value"}, "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}, "provenance": {"$ref": "#/$defs/provenance"}}},
    "credential": {"type": "object", "additionalProperties": false, "required": ["id", "type", "in", "name"], "properties": {"id": {"type": "string"}, "type": {"enum": ["bearer", "api-key", "session-cookie"]}, "in": {"enum": ["header", "query", "cookie"]}, "name": {"type": "string"}}},
    "auth": {"type": "object", "additionalProperties": false, "required": ["mode", "credentials"], "properties": {"mode": {"enum": ["none", "optional", "required"]}, "credentials": {"type": "array", "items": {"$ref": "#/$defs/credential"}}}},
    "capability": {"type": "object", "additionalProperties": false, "required": ["id", "apiVersion"], "properties": {"id": {"type": "string"}, "apiVersion": {"type": "string"}}},
    "operation": {"type": "object", "additionalProperties": false, "required": ["id", "method", "path", "requestType", "responseBody", "auth", "permission", "errorProjections", "provenance"], "properties": {"id": {"type": "string"}, "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]}, "path": {"type": "string"}, "requestType": {"type": "string"}, "responseBody": {"enum": ["json", "none"]}, "responseType": {"type": "string"}, "auth": {"$ref": "#/$defs/auth"}, "permission": {"type": "string"}, "capability": {"$ref": "#/$defs/capability"}, "errorProjections": {"type": "array", "items": {"type": "object"}}, "provenance": {"$ref": "#/$defs/provenance"}}}
  }
}
