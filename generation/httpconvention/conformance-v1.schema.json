{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/generation/httpconvention/conformance-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "requestCases", "successCases", "paginationCases"],
  "properties": {
    "apiVersion": {"const": "nexa.dev/http-convention/v1"},
    "kind": {"const": "HTTPConventionConformance"},
    "requestCases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "method", "path", "fields", "locations"], "properties": {"name": {"type": "string"}, "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]}, "path": {"type": "string", "pattern": "^/"}, "fields": {"type": "array", "items": {"type": "string"}}, "locations": {"type": "array", "items": {"enum": ["path", "query", "body"]}}}}},
    "successCases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["method", "path", "status"], "properties": {"method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]}, "path": {"type": "string", "pattern": "^/"}, "status": {"const": 200}}}},
    "paginationCases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["limit", "offset", "accepted"], "properties": {"limit": {"type": "integer"}, "offset": {"type": "integer"}, "accepted": {"type": "boolean"}}}}
  }
}
