{
  "apiVersion": "nexa.dev/http-convention/v1",
  "kind": "HTTPConventionConformance",
  "namingCases": [
    {"source": "TenantID", "accepted": true, "canonical": "tenantId"},
    {"source": "created_at", "accepted": true, "canonical": "createdAt"},
    {"source": "tenant-id", "accepted": false}
  ],
  "requestCases": [
    {
      "name": "list-records",
      "method": "GET",
      "path": "/api/records",
      "fields": ["page", "pageSize", "query"],
      "locations": ["query", "query", "query"]
    },
    {
      "name": "update-record",
      "method": "PATCH",
      "path": "/api/records/{id}",
      "fields": ["id", "expectedVersion", "name"],
      "locations": ["path", "body", "body"]
    },
    {
      "name": "delete-record",
      "method": "DELETE",
      "path": "/api/records/{id}",
      "fields": ["id"],
      "locations": ["path"]
    }
  ],
  "successCases": [
    {"method": "GET", "path": "/api/records", "hasRepresentation": true, "status": 200},
    {"method": "POST", "path": "/api/records", "hasRepresentation": true, "status": 201},
    {"method": "POST", "path": "/api/records/{id}/actions/archive", "hasRepresentation": true, "status": 200},
    {"method": "PATCH", "path": "/api/records/{id}", "hasRepresentation": true, "status": 200},
    {"method": "DELETE", "path": "/api/records/{id}", "hasRepresentation": false, "status": 204}
  ],
  "paginationCases": [
    {"page": 1, "pageSize": 20, "accepted": true},
    {"page": 0, "pageSize": 20, "accepted": false},
    {"page": 1, "pageSize": 101, "accepted": false}
  ],
  "problemCases": [
