    {"category": "failed_precondition", "code": "record_version_mismatch", "status": 422, "type": "https://nexa.dev/problems/v1/failed-precondition"},
    {"category": "not_ready", "code": "database_not_ready", "status": 503, "type": "https://nexa.dev/problems/v1/not-ready"}
  ],
  "scalarCases": [
