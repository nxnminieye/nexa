{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/generation/toolchain/ent-helper-module-graph-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "consumerModule", "goVersion", "helperDigest", "moduleSources", "modules", "toolModule"],
  "properties": {
    "apiVersion": {"const": "nexa.dev/ent-helper-module-graph/v1"},
    "kind": {"const": "EntHelperModuleGraph"},
    "consumerModule": {"$ref": "#/$defs/requirement"},
    "goVersion": {"type": "string", "minLength": 1},
    "helperDigest": {"$ref": "#/$defs/digest"},
    "moduleSources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "modules": {"type": "array", "items": {"$ref": "#/$defs/module"}},
    "toolModule": {"$ref": "#/$defs/requirement"},
    "toolchainVersion": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "h1": {"type": "string", "pattern": "^h1:[A-Za-z0-9+/]{43}=$"},
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "ref"],
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "ref": {"type": "string", "pattern": "^repo:"}
      }
    },
    "replacement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "none"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "version"],
          "properties": {
            "kind": {"const": "version"},
            "path": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repositoryPath"],
          "properties": {
            "kind": {"const": "repository"},
            "repositoryPath": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "local"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["goModSum", "kind"],
          "properties": {
            "goModSum": {"$ref": "#/$defs/h1"},
            "kind": {"const": "remote"},
            "sum": {"$ref": "#/$defs/h1"}
          }
        }
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "path", "replacement", "version"],
      "properties": {
        "content": {"$ref": "#/$defs/content"},
        "path": {"type": "string", "minLength": 1},
        "replacement": {"$ref": "#/$defs/replacement"},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
