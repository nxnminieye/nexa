{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/generation/protocol/protocol-ir-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "serviceId", "sourceDigest", "sources", "files"],
  "properties": {
    "apiVersion": {"const": "nexa.dev/protocol-ir/v3"},
    "kind": {"const": "ProtocolIR"},
    "serviceId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "sourceDigest": {"$ref": "#/$defs/digest"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "files": {"type": "array", "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceRef": {"type": "string", "pattern": "^repo:.+"},
    "source": {"type": "object", "additionalProperties": false, "required": ["ref", "digest"], "properties": {"ref": {"$ref": "#/$defs/sourceRef"}, "digest": {"$ref": "#/$defs/digest"}}},
    "typeValue": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": {"kind": {"enum": ["scalar", "enum", "message"]}, "name": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "key", "value"], "properties": {"kind": {"const": "map"}, "key": {"$ref": "#/$defs/typeValue"}, "value": {"$ref": "#/$defs/typeValue"}}}
      ]
    },
    "field": {"type": "object", "additionalProperties": false, "required": ["fullName", "number", "jsonName", "cardinality", "presence", "type", "sourceRef"], "properties": {"fullName": {"type": "string", "minLength": 1}, "number": {"type": "integer", "minimum": 1}, "jsonName": {"type": "string", "minLength": 1}, "cardinality": {"enum": ["singular", "repeated"]}, "presence": {"enum": ["implicit", "explicit", "oneof", "map"]}, "type": {"$ref": "#/$defs/typeValue"}, "oneof": {"type": "string", "minLength": 1}, "sourceRef": {"$ref": "#/$defs/sourceRef"}}},
    "message": {"type": "object", "additionalProperties": false, "required": ["fullName", "sourceRef", "fields"], "properties": {"fullName": {"type": "string", "minLength": 1}, "sourceRef": {"$ref": "#/$defs/sourceRef"}, "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}}},
    "enumValue": {"type": "object", "additionalProperties": false, "required": ["name", "number"], "properties": {"name": {"type": "string", "minLength": 1}, "number": {"type": "integer"}}},
    "enum": {"type": "object", "additionalProperties": false, "required": ["fullName", "values"], "properties": {"fullName": {"type": "string", "minLength": 1}, "values": {"type": "array", "items": {"$ref": "#/$defs/enumValue"}}}},
    "method": {"type": "object", "additionalProperties": false, "required": ["fullName", "input", "output", "clientStreaming", "serverStreaming", "sourceRef"], "properties": {"fullName": {"type": "string", "minLength": 1}, "input": {"type": "string", "minLength": 1}, "output": {"type": "string", "minLength": 1}, "clientStreaming": {"type": "boolean"}, "serverStreaming": {"type": "boolean"}, "sourceRef": {"$ref": "#/$defs/sourceRef"}}},
    "service": {"type": "object", "additionalProperties": false, "required": ["fullName", "methods"], "properties": {"fullName": {"type": "string", "minLength": 1}, "methods": {"type": "array", "items": {"$ref": "#/$defs/method"}}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "messages", "enums", "services"], "properties": {"path": {"type": "string", "pattern": "^[^/].*\\.proto$"}, "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}}, "enums": {"type": "array", "items": {"$ref": "#/$defs/enum"}}, "services": {"type": "array", "items": {"$ref": "#/$defs/service"}}}}
  }
}
