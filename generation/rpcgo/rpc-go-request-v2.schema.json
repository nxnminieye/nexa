{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/generation/rpcgo/rpc-go-request-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "serviceId", "modulePath", "protocolIR", "outputScopes"],
  "properties": {
    "apiVersion": {"const": "nexa.dev/rpc-go-request/v2"},
    "kind": {"const": "RPCGoRequest"},
    "serviceId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "modulePath": {"type": "string", "minLength": 1, "maxLength": 1024},
    "protocolIR": {"$ref": "https://nexa.dev/schemas/generation/protocol/protocol-ir-v2.schema.json"},
    "outputScopes": {"$ref": "#/$defs/scopes"}
  },
  "$defs": {
    "scope": {"type": "object", "additionalProperties": false, "required": ["path", "mode"], "properties": {"path": {"type": "string", "minLength": 1}, "mode": {"enum": ["replace-tree", "file-set"]}}},
    "scopes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scope"}}
  }
}
