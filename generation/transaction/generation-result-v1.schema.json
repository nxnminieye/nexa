{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/generation-result-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "planDigest", "status", "changes", "conflicts"],
  "properties": {
    "apiVersion": {"const": "nexa.dev/generation-result/v1"},
    "kind": {"const": "GenerationResult"},
    "planDigest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["clean", "changes-required", "conflict"]},
    "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "path", "digest"],
      "properties": {
        "kind": {"enum": ["create", "update", "delete", "create-manual"]},
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "priorDigest": {"$ref": "#/$defs/digest"},
        "controlRole": {"const": "compatibility-lock"}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "controlRole": {"const": "compatibility-lock"}
      }
    }
  }
}
