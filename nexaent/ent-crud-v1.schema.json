{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/nexaent/ent-crud-v1.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "payload"],
      "properties": {
        "apiVersion": {"const": "nexa.dev/ent-crud/v1"},
        "kind": {"const": "EntCRUD"},
        "payload": {"$ref": "#/$defs/payload"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "duplicate"],
      "properties": {
        "apiVersion": {"const": "nexa.dev/ent-crud/v1"},
        "kind": {"const": "EntCRUD"},
        "duplicate": {"const": true}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "invalid"],
      "properties": {
        "apiVersion": {"const": "nexa.dev/ent-crud/v1"},
        "kind": {"const": "EntCRUD"},
        "invalid": {"$ref": "#/$defs/invalid"}
      }
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations"],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["list", "get", "create", "update", "delete"]}
        }
      }
    },
    "invalid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "pointer"],
      "properties": {
        "reason": {"enum": ["crud_operations_empty", "enum_invalid", "crud_operation_duplicate", "unicode_invalid"]},
        "pointer": {"type": "string"}
      }
    }
  }
}
