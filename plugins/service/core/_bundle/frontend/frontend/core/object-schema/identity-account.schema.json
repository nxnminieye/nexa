{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/frontend/core/identity-account.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["username", "displayName", "status"],
  "properties": {
    "username": {"type": "string", "minLength": 1, "title": "core.identity.username"},
    "displayName": {"type": "string", "minLength": 1, "title": "core.identity.displayName"},
    "email": {"type": "string", "format": "email", "title": "core.identity.email"},
    "status": {"type": "string", "enum": ["enabled", "disabled"], "title": "core.identity.status"}
  }
}
