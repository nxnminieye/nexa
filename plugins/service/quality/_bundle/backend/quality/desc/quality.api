// @nexa $contract: "nexa.dev/source-comment/v1"
syntax = "v1"

info (nexaContractVersion: "nexa.dev/http-convention/v1")

type RequirementCoverage {
  Requirement string
  Title string
  Status string
  TestRefs []string
  EvidenceRefs []string
  FreezeRefs []string
  FreezeStatus string
  GapCodes []string
}

type SnapshotRequest {}

type SnapshotResponse {
  APIVersion string
  Kind string
  SourceProfile string
  ReadModelScope string
  Revision string
  Requirements []RequirementCoverage
}

type HealthRequest {}

type HealthResponse {
  Ready bool
  Code string
}

service quality-api {
  // @nexa auth: "none"
  @handler Snapshot
  get /quality/snapshot (SnapshotRequest) returns (SnapshotResponse)
}

service quality-api {
  // @nexa auth: "none"
  @handler Health
  get /health (HealthRequest) returns (HealthResponse)
}
