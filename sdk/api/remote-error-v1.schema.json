{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/sdk/api/remote-error-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "domain", "code", "message"],
  "properties": {
    "apiVersion": {
      "const": "nexa.dev/remote-error/v1"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "not": {"pattern": "[\u0000-\u001F\u007F-\u009F]"}
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "not": {"pattern": "[\u0000-\u001F\u007F-\u009F]"}
    },
    "message": {
      "type": "string",
      "not": {"pattern": "[\u0000-\u001F\u007F-\u009F]"}
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\u0000-\u001F\u007F-\u009F]"}
    },
    "traceId": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\u0000-\u001F\u007F-\u009F]"}
    },
    "details": {
      "type": "object"
    }
  }
}
