{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/runtime-adapter-result-v1.schema.json",
  "title": "Nexa Runtime API Adapter Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "cases"],
  "properties": {
    "apiVersion": {"const": "nexa.dev/runtime-api-adapter-result/v1"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiOperationId", "httpStatus", "responseBody", "hasJSON", "canonicalJSON"],
      "properties": {
        "apiOperationId": {"type": "string", "minLength": 1},
        "httpStatus": {"type": "integer", "minimum": 200, "maximum": 299},
        "responseBody": {"enum": ["json", "none"]},
        "hasJSON": {"type": "boolean"},
        "canonicalJSON": {"type": "string"}
      },
      "oneOf": [
        {"properties": {"responseBody": {"const": "json"}, "hasJSON": {"const": true}, "canonicalJSON": {"minLength": 1}}},
        {"properties": {"responseBody": {"const": "none"}, "hasJSON": {"const": false}, "canonicalJSON": {"const": ""}}}
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "code", "message", "category", "retryable", "apiOperationId", "requestId", "traceId", "reason", "pointer", "httpStatus", "remoteDomain", "remoteCode", "remoteDetailsAbsent"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "category": {"enum": ["usage", "input", "review", "drift", "conflict", "unavailable", "external", "canceled", "internal"]},
        "retryable": {"type": "boolean"},
        "apiOperationId": {"type": "string"},
        "requestId": {"type": "string"},
        "traceId": {"type": "string"},
        "reason": {"type": "string"},
        "pointer": {"type": "string"},
        "httpStatus": {"type": "integer", "maximum": 599, "oneOf": [{"const": 0}, {"minimum": 200}]},
        "remoteDomain": {"type": "string"},
        "remoteCode": {"type": "string"},
        "remoteDetailsAbsent": {"const": true}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "success": {"$ref": "#/$defs/success"},
        "error": {"$ref": "#/$defs/error"}
      },
      "oneOf": [
        {"required": ["success"]},
        {"required": ["error"]}
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "requestDigest", "providerCalls", "transportCalls", "bodyReadCalls", "bodyCloseCalls", "outcome"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "requestDigest": {"type": "string", "pattern": "^(absent|sha256:[0-9a-f]{64})$"},
        "providerCalls": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "transportCalls": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "bodyReadCalls": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "bodyCloseCalls": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "outcome": {"$ref": "#/$defs/outcome"}
      }
    }
  }
}
