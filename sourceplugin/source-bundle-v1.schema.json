{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexa.dev/schemas/source-bundle-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "identity", "files", "profiles"],
  "properties": {
    "apiVersion": {"type": "string", "const": "nexa.dev/source-bundle/v1"},
    "kind": {"type": "string", "const": "SourceBundle"},
    "identity": {"$ref": "#/$defs/identity"},
    "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "modulePath", "packagePath", "version"],
      "properties": {
        "providerId": {"$ref": "#/$defs/stableId"},
        "modulePath": {"type": "string", "minLength": 1},
        "packagePath": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "digest", "mode"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 0},
        "digest": {"$ref": "#/$defs/digest"},
        "mode": {"type": "string", "enum": ["0644", "0755"]}
      }
    },
    "bundleRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "modulePath", "packagePath", "version", "profileId", "manifestDigest", "treeDigest"],
      "properties": {
        "providerId": {"$ref": "#/$defs/stableId"},
        "modulePath": {"type": "string", "minLength": 1},
        "packagePath": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "profileId": {"$ref": "#/$defs/stableId"},
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "treeDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "workingDirectory", "packages"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "kind": {"type": "string", "enum": ["go-test", "go-build"]},
        "workingDirectory": {"type": "string", "minLength": 1},
        "packages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "files"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "files": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "requiresProfiles": {"type": "array", "items": {"$ref": "#/$defs/stableId"}},
        "requiresBundles": {"type": "array", "items": {"$ref": "#/$defs/bundleRequirement"}},
        "validations": {"type": "array", "items": {"$ref": "#/$defs/validation"}}
      }
    }
  }
}
